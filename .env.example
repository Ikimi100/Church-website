# Copy to .env and fill values
PORT=3000
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional price IDs for subscriptions (create in Stripe dashboard)
STRIPE_MONTHLY_PRICE_ID=price_xxx
STRIPE_YEARLY_PRICE_ID=price_xxx
# Public success/cancel URLs (adjust when deploying)
SUCCESS_URL=http://localhost:3000/donate.html
CANCEL_URL=http://localhost:3000/donate.html
# SMTP settings for sending receipts
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
RECEIPT_FROM="Messianic Movement" <no-reply@example.com>

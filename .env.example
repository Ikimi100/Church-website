# Copy to .env and fill values
PORT=3000

# ---- Donations (existing Stripe flow) ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional price IDs for subscriptions (create in Stripe dashboard)
STRIPE_MONTHLY_PRICE_ID=price_xxx
STRIPE_YEARLY_PRICE_ID=price_xxx
# Public success/cancel URLs (adjust when deploying)
SUCCESS_URL=http://localhost:3000/donate.html
CANCEL_URL=http://localhost:3000/donate.html

# ---- Email receipts (SMTP) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
RECEIPT_FROM="Messianic Movement" <no-reply@example.com>

# ---- Database (registrations + orders + expenses) ----
# Pick ONE option (first match wins). Leave ALL blank to use local JSON files
# in data/ for testing (zero setup).

# Option A - Supabase (REST client). Use the SERVICE ROLE key (server-side only!),
#   then run supabase_schema.sql once in the Supabase SQL editor.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Option B - Postgres connection string. Works with Supabase's own connection
#   string, Neon, Railway, RDS, or local Postgres. Tables are auto-created.
DATABASE_URL=

# Option C - MongoDB Atlas connection string.
MONGODB_URI=
MONGODB_DB=messianic_movement

# ---- Admin dashboard ----
# Password to access /admin.html. CHANGE THIS to a long, private value.
ADMIN_PASSWORD=change-me-to-a-strong-secret
# Secret used to sign admin session tokens (any long random string).
SESSION_SECRET=change-me-too-random-string

# ---- Sample data ----
# Set to "false" to stop seeding demo sales/registrations into an empty database.
SEED_SAMPLE_DATA=true
